import numpy as np
import matplotlib.pyplot as plt

k = 8.99e9
q = 1
N = 20

x_charge1, y_charge1 = 3.0, 7.0 #coordinates for charge 1
x_charge2, y_charge2 = 9.0, 7.0 #coordinates for charge 2

#set up grid boundaries
x = np.linspace(0.0, 12.0, N) + 1e-6 
y = np.linspace(0.0, 14.0, N) + 1e-6
X, Y = np.meshgrid(x, y)

#field 1
dx1 = X - x_charge1
dy1 = Y - y_charge1
thE1 = np.arctan2(dy1, dx1)        
magE1 = k * q / (dx1**2.0 + dy1**2.0) 
Ex1 = magE1 * np.cos(thE1)
Ey1 = magE1 * np.sin(thE1)

#field 2
dx2 = X - x_charge2
dy2 = Y - y_charge2
thE2 = np.arctan2(dy2, dx2)        
magE2 = k * q / (dx2**2.0 + dy2**2.0) 
Ex2 = magE2 * np.cos(thE2)
Ey2 = magE2 * np.sin(thE2)

#superposition/vector addition
Ex_total = Ex1 + Ex2
Ey_total = Ey1 + Ey2

#combined field strength
magE_total = np.sqrt(Ex_total**2.0 + Ey_total**2.0)
mask = magE_total > 40 

#quiver plot
fig, ax = plt.subplots()
q_plot = ax.quiver(X[mask], Y[mask], Ex_total[mask], Ey_total[mask])

#mark both charge locations visually
ax.plot(x_charge1, y_charge1, 'ro', label='Charge 1 (+)')
ax.plot(x_charge2, y_charge2, 'bo', label='Charge 2 (+)')

ax.set_aspect('equal')
ax.set_xlabel('x')
ax.set_ylabel('y')
ax.legend()
plt.show()
