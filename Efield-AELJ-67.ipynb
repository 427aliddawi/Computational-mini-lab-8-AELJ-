import numpy as np
import matplotlib.pyplot as plt
k=8.99e9
q=1
N=20

x_charge, y_charge = 6.0, 7.0 #define the coordinates for the charge position

x = np.linspace(0.0,12.0,N)+1e-6 # so as not to have point at zero
y = np.linspace(0.0,14.0,N)+1e-6
X,Y = np.meshgrid(x,y)

dx = X - x_charge
dy = Y - y_charge

# now find field
thE = np.arctan2(dy, dx)        
magE = k * q / (dx**2.0 + dy**2.0) 
mask = magE > 40 # will have big values near origin
Ex = magE*np.cos(thE)
Ey = magE*np.sin(thE)

# quiver plot
fig, ax = plt.subplots()
q = ax.quiver(X[mask],Y[mask],Ex[mask],Ey[mask])
ax.set_aspect('equal')
ax.set_xlabel('x')
ax.set_ylabel('y')
plt.show()
